# MSSQL 連線（使用既有容器 mssql_2022_rtm_gdr1，資料庫 ServiceMonitor）
DB_URL=mssql+pymssql://monitor_app:<password>@127.0.0.1:1433/ServiceMonitor
# 產生：python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
FERNET_KEY=
JWT_SECRET=
# 選填：users 表為空時建立 admin 用的密碼；不填則隨機產生並印在 docker compose logs
# ADMIN_INIT_PASSWORD=
# 對外網址（LINE Webhook URL 會用到）
PUBLIC_BASE_URL=https://monitor.careloger.com
TZ=Asia/Taipei
RETENTION_DAYS=90
